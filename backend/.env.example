# --- Banco de dados ---
# SQLite (dev):      sqlite+aiosqlite:///./integra.db
# PostgreSQL (prod): postgresql+asyncpg://usuario:senha@host:5432/integra
DATABASE_URL=sqlite+aiosqlite:///./integra.db

# --- Segurança do painel ---
ADMIN_PASSWORD=troque-esta-senha
# Chave para assinar tokens de sessão (gere com: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
# Origem(ns) do frontend, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# --- Anthropic (pode ser alterado depois pelo painel em /configuracoes) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- UAZAP (pode ser alterado pelo painel) ---
# URL do seu servidor UAZAP, ex.: https://seu-subdominio.uazapi.com
UAZAP_BASE_URL=
# Admin token da UAZAP (header "admintoken"): fica só no backend
UAZAP_ADMIN_TOKEN=
# Segredo anexado à URL do webhook (?secret=...). A UAZAP não envia headers customizados.
WEBHOOK_SECRET=troque-este-segredo
# URL pública (HTTPS) deste backend; registrada como webhook em cada instância nova
PUBLIC_BACKEND_URL=https://seu-dominio.com
